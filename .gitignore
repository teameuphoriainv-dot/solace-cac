# Editor and OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Trained model files (about 250 MB). scripts/fetch_models.sh downloads them
# from the GitHub release and checks every file against a pinned sha256.
backend/models/*
!backend/models/.gitkeep
# The release tarball, if you rebuild it here (see "The model release" in deploy/DEPLOY.md).
solace-models-*.tar.gz

# Kaggle Triagegeist training data (competition data, not ours to redistribute).
# scripts/train_triage_model.py reads it from data/triagegeist/.
/data/

# Runtime files: uploaded photos, generated audio, scratch space
backend/tmp/
tmp/

# Our own submission notes (checklist, video script, written-answer drafts). They stay on
# our computers and are never published with the code.
docs/submission/
