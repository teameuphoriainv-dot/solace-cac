# Secrets (copy .env.example to .env; never commit the real one)
.env
.env.*
!.env.example
*.pem
*.key
.secrets/

# AI coding-assistant tooling (local settings, agent memory, absolute paths)
.claude/
.claude-flow/
.swarm/
.hive-mind/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/

# Node and the built frontend
node_modules/
.pnpm-store/
.vite/
dist/
*.tsbuildinfo
frontend/vite.config.js
.vercel
*.log
