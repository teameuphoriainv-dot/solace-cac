# Keep the build context small and free of secrets. backend/models is NOT ignored:
# if the model files are there, the image uses them instead of downloading.
.git/
.env
.env.*
!.env.example
.secrets/
*.pem
*.key

.claude/
.claude-flow/
**/.claude-flow/
.swarm/
.hive-mind/

**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
backend/.venv/
**/.venv/
**/venv/

**/node_modules/
frontend/dist/
**/*.tsbuildinfo
.vercel/
**/.vercel/

backend/tmp/
tmp/
/data/
backend/models/*.tar.gz
solace-models-*.tar.gz

.DS_Store
**/.DS_Store
*.log
.vscode/
.idea/
