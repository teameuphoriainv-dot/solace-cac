# Solace settings. Copy this file to .env in the repo root (next to this file) and fill
# in only what you need. Every line is optional: with no .env at all, Solace runs fully
# on this computer with no AI keys and makes no outside calls.
#
# On a host (AWS App Runner, Hugging Face Spaces, Render), set these in the host's settings
# instead.
# Put keys in its "secrets", never in the code. Never commit a real .env.

# ---- Mode ---------------------------------------------------------------------------
# "local" keeps all data in memory on this machine. The Docker image always uses local.
SOLACE_MODE=local

# ---- Optional AI keys (each one switches on extra features) --------------------------
# Claude: comfort text, follow-up questions, translating non-English check-ins, the AI
# red-flag check (it can only raise the score), notes, reasoning, prescription ideas,
# reading ID and insurance card photos. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Server-side speech to text (Whisper) for browsers that cannot dictate live.
OPENAI_API_KEY=
# Spoken audio of the waiting-room guidance. The browser read-aloud works without it.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Which Claude model each kind of task uses (defaults shown).
# MODEL_CLINICAL=claude-haiku-5-5
# MODEL_UTILITY=claude-haiku-5-5

# ---- AI spend guard (matters only when ANTHROPIC_API_KEY is set) --------------------
# Stop calling Claude for the rest of the day (UTC) once this many US dollars are spent.
# 0 turns AI off. Also set a spend limit in the Anthropic Console as a hard backstop.
AI_DAILY_BUDGET_USD=3
# How many Claude calls one visitor (IP address + browser) can cause per hour, counting the
# background clinician summaries made after each check-in (about 8 calls per check-in).
AI_CALLS_PER_VISITOR_HOUR=120
# Limits for everyone together, so one burst cannot switch AI off for the whole day: at most
# this share of the daily budget in one clock hour (UTC), and at most this many Claude calls
# in any 60 seconds (0 turns the per-minute ceiling off).
AI_HOURLY_BUDGET_FRACTION=0.35
AI_CALLS_PER_MINUTE=40
# How many proxies in front of this server add an X-Forwarded-For entry. AWS App Runner's
# proxy appends the real client address as the LAST entry, so 1 trusts only that one.
# Use 0 when nothing sits in front of the server (then the connection's own address is used).
SOLACE_TRUSTED_PROXY_HOPS=1

# ---- Demo data and judge sandboxes --------------------------------------------------
# Add the five fictional example patients at startup (0 to skip).
SOLACE_SEED_DEMO=1
# Load the bedside model in the background at startup (0 to load it on first use).
SOLACE_WARM_MODEL=1
# Each visitor gets a private demo hospital (an id like demo-k3x9q2). It is cleared after
# this many idle minutes, and at most this many exist at once.
SANDBOX_IDLE_MINUTES=120
SANDBOX_MAX=300
# One client address may create this many new sandboxes an hour and keep this many alive.
# Past either limit, or when all SANDBOX_MAX are in use, the visitor gets the shared "demo"
# hospital instead (never an error).
SANDBOX_CREATES_PER_CLIENT_HOUR=5
SANDBOX_LIVE_PER_CLIENT=10
# Check-ins in the shared "demo" hospital are removed after this many hours (0 keeps them).
DEMO_WALKIN_MAX_HOURS=6
# Folder with the built frontend to serve at /. Empty means frontend/dist if it exists.
# SOLACE_STATIC_DIR=

# ---- Hosted demo only (deploy/aws/apprunner.md) --------------------------------------
# Public address of the hosted app. The served page then gets absolute og:image and
# twitter:image links and an og:url, which some link previews need.
# SOLACE_PUBLIC_URL=https://example.us-east-1.awsapprunner.com
# AWS Secrets Manager secret (name or ARN) that holds {"ANTHROPIC_API_KEY": "..."}. It is
# read once at startup. Leave it unset on your own computer: then Solace never contacts AWS.
# SOLACE_KEYS_SECRET=

# =====================================================================================
# The settings below are read straight from the environment. Set them on the host, or
# export them in your shell before starting the server (for example
# `export SOLACE_JWT_SECRET=...`). Putting them in .env has no effect.
# =====================================================================================

# Text messages are off unless you choose a provider. "none" never sends; the app shows
# the exact text it would have sent. For real texts use SMS_PROVIDER=twilio plus:
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM_NUMBER=

# Signing key for clinician sign-in tokens. If empty, a random key is made at startup and
# everyone must sign in again after a restart. Set one if you run more than one worker.
# SOLACE_JWT_SECRET=

# Port for "python main.py" and the Docker image (uvicorn on the command line uses --port).
# PORT=8000

# Extra browser origins allowed to call the API, comma separated. Local dev ports are
# already allowed, and none are needed when the backend serves the frontend itself.
# SOLACE_CORS_ORIGINS=

# Where the trained model files live (default backend/models). scripts/fetch_models.sh
# reads the same variable, plus these for where to download the model from:
# SOLACE_MODELS_DIR=
# SOLACE_MODELS_REPO=teameuphoriainv-dot/solace-cac
# SOLACE_MODELS_TAG=models-v1
# SOLACE_MODELS_URL=
